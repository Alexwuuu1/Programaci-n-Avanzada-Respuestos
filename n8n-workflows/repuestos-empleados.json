      "name": "API Empleados"
    },
    {
      "parameters": {
        "jsCode": "const empleados = Array.isArray($input.first().json) ? $input.first().json : [];\nconst pregunta = $('Webhook Empleados').item.json.body?.chatInput || '';\nconst activos = empleados.filter((e) => (e.status || e.estado || '').toLowerCase() === 'activo');\nconst porCargo = empleados.reduce((acc, e) => { const k = e.position || e.cargo || 'Sin cargo'; acc[k] = (acc[k] || 0) + 1; return acc; }, {});\nreturn [{ json: { pregunta, empleados, resumen: { total: empleados.length, activos: activos.length, porCargo } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "9a1e5cde-2e36-4a3e-871f-8598d2186139",
      "name": "Preparar Empleados"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres Alejandro, operador web de personal/RRHH.\n\nConsulta: \"{{ $json.pregunta }}\"\n\nResumen real:\n{{ JSON.stringify($json.resumen) }}\n\nEmpleados:\n{{ JSON.stringify($json.empleados) }}\n\nReglas:\n- Responde solo sobre empleados, cargos, estado y personal.\n- No inventes datos.\n- No reveles salario, CI, direccion o datos sensibles salvo que el usuario lo pida explicitamente.\n- Si preguntan activos, cargos o resumen, usa el resumen real.\n- Si no entiendes, ofrece ejemplos: empleados activos, cargos, personal registrado.\n- Cierra con una pregunta breve."
      },
