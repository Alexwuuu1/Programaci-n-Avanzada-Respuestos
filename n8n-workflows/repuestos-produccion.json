      "name": "API Produccion"
    },
    {
      "parameters": {
        "jsCode": "const ordenes = Array.isArray($input.first().json) ? $input.first().json : [];\nconst pregunta = $('Webhook Produccion').item.json.body?.chatInput || '';\nconst activas = ordenes.filter((o) => ['Pendiente', 'EnProceso', 'En Proceso'].includes(o.status || o.estado));\nconst completadas = ordenes.filter((o) => ['Completado', 'Finalizado'].includes(o.status || o.estado));\nconst urgentes = ordenes.filter((o) => String(o.priority || o.prioridad || '').toLowerCase().includes('urgente') || String(o.priority || o.prioridad || '').toLowerCase().includes('alta'));\nreturn [{ json: { pregunta, ordenes: ordenes.slice(0, 50), activas, resumen: { total: ordenes.length, activas: activas.length, completadas: completadas.length, urgentes: urgentes.length } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "05c77735-2e54-44d9-8012-ab97cfb1ca75",
      "name": "Preparar Produccion"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres Alejandro, operador web de produccion/fabrica.\n\nConsulta: \"{{ $json.pregunta }}\"\n\nResumen real:\n{{ JSON.stringify($json.resumen) }}\n\nOrdenes recientes:\n{{ JSON.stringify($json.ordenes) }}\n\nOrdenes activas:\n{{ JSON.stringify($json.activas) }}\n\nReglas:\n- Responde solo sobre produccion, ordenes, lotes, responsables, prioridades y estado de fabrica.\n- No inventes datos.\n- Si preguntan activas o pendientes, lista producto, cantidad, responsable, estado, prioridad y fechas si existen.\n- Si preguntan completadas, resume las ultimas completadas.\n- Si no entiendes, ofrece ejemplos: ordenes activas, produccion pendiente, lotes finalizados, urgentes.\n- Cierra con una pregunta breve."
      },
