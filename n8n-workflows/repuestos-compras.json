      "name": "API Compras"
    },
    {
      "parameters": {
        "jsCode": "const compras = Array.isArray($input.first().json) ? $input.first().json : [];\nconst pregunta = $('Webhook Compras').item.json.body?.chatInput || '';\nconst pendientes = compras.filter((c) => c.status === 'Pendiente');\nconst recibidas = compras.filter((c) => c.status === 'Recibido');\nconst canceladas = compras.filter((c) => c.status === 'Cancelado');\nconst totalPendiente = pendientes.reduce((s, c) => s + Number(c.total || 0), 0);\nconst totalRecibido = recibidas.reduce((s, c) => s + Number(c.total || 0), 0);\nreturn [{ json: { pregunta, compras: compras.slice(0, 50), pendientes, resumen: { total: compras.length, pendientes: pendientes.length, recibidas: recibidas.length, canceladas: canceladas.length, totalPendiente, totalRecibido } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "998f1607-610c-444e-b5dc-76539d8151c8",
      "name": "Preparar Compras"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres Alejandro, operador web de compras y proveedores.\n\nConsulta: \"{{ $json.pregunta }}\"\n\nResumen real:\n{{ JSON.stringify($json.resumen) }}\n\nCompras recientes:\n{{ JSON.stringify($json.compras) }}\n\nPedidos pendientes:\n{{ JSON.stringify($json.pendientes) }}\n\nReglas:\n- Responde solo sobre compras, pedidos a proveedor, recepciones y abastecimiento.\n- No inventes datos.\n- Formatea importes en Bs.\n- Si preguntan pendientes, lista proveedor, fecha, total, referencia y productos.\n- Si preguntan recibidas, resume compras recibidas recientes.\n- Si no entiendes, ofrece ejemplos: compras pendientes, pedidos recibidos, total comprometido, ultimo pedido.\n- Cierra con una pregunta breve."
      },
