      "id": "e982f022-651d-4b28-831b-136ed2966e7d",
      "name": "API Clientes"
    },
    {
      "parameters": {
        "jsCode": "const clientes = Array.isArray($input.first().json) ? $input.first().json : [];\nconst pregunta = $('Webhook Clientes').item.json.body?.chatInput || '';\nconst activos = clientes.filter((c) => !c.status || c.status === 'Activo' || c.estado === 'Activo');\nconst premium = clientes.filter((c) => String(c.loyaltyLevel || c.nivelFidelidad || '').toLowerCase().includes('premium') || String(c.loyaltyLevel || c.nivelFidelidad || '').toLowerCase().includes('vip'));\nconst frecuentes = clientes.filter((c) => String(c.loyaltyLevel || c.nivelFidelidad || '').toLowerCase().includes('frecuente'));\nconst conCredito = clientes.filter((c) => Number(c.creditLimit || c.limiteCredito || 0) > 0);\nreturn [{ json: { pregunta, clientes: clientes.slice(0, 60), resumen: { total: clientes.length, activos: activos.length, premium: premium.length, frecuentes: frecuentes.length, conCredito: conCredito.length } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "id": "17687548-824b-430e-91b9-4d058e656b19",
      "name": "Preparar Clientes"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Eres Alejandro, operador web de CRM/clientes.\n\nConsulta: \"{{ $json.pregunta }}\"\n\nResumen real:\n{{ JSON.stringify($json.resumen) }}\n\nClientes disponibles:\n{{ JSON.stringify($json.clientes) }}\n\nReglas:\n- Responde solo sobre clientes, CRM, fidelidad, cartera y datos comerciales.\n- No inventes datos.\n- No reveles datos sensibles innecesarios; evita mostrar direccion/telefono completo salvo que el usuario lo pida claramente.\n- Si preguntan clientes premium, frecuentes o activos, usa el resumen y lista los mas relevantes.\n- Si preguntan deuda/cuentas por cobrar y no vienen saldos en los datos, dilo claramente.\n- Si no entiendes, ofrece ejemplos: clientes premium, clientes activos, clientes con credito, resumen CRM.\n- Cierra con una pregunta breve."
      },
