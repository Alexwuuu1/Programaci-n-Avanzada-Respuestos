datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(255)
  permisos    String?   @db.Text
  color       String?   @db.VarChar(20)
  usuarios    Usuario[]

  @@map("roles")
}

model Empleado {
  id                  Int                 @id @default(autoincrement())
  nombre              String              @db.VarChar(100)
  ci                  String?             @db.VarChar(20)
  email               String?             @db.VarChar(150)
  telefono            String              @db.VarChar(20)
  direccion           String?             @db.Text
  cargo               String              @db.VarChar(100)
  turno               String?             @db.VarChar(30)
  salario             Decimal?            @db.Decimal(10, 2)
  fechaNacimiento     DateTime?           @map("fecha_nacimiento") @db.Date
  fechaContratacion   DateTime?           @map("fecha_contratacion") @db.Date
  contactoEmergencia  String?             @map("contacto_emergencia") @db.VarChar(150)
  notas               String?             @db.Text
  estado              String              @default("Activo") @db.VarChar(20)
  creadoEn            DateTime            @default(now()) @map("creado_en")
  usuario             Usuario?
  produccion          OrdenProduccion[]

  @@map("empleados")
}

model Usuario {
  id                 Int                 @id @default(autoincrement())
  usuario            String              @unique @db.VarChar(50)
  contrasena         String              @db.VarChar(255)
  email              String?             @db.VarChar(150)
  estado             String              @default("Activo") @db.VarChar(20)
  ultimoAcceso       DateTime?           @map("ultimo_acceso")
  rolId              Int                 @map("rol_id")
  empleadoId         Int?                @unique @map("empleado_id")
  creadoEn           DateTime            @default(now()) @map("creado_en")
  
  rol                Role                @relation(fields: [rolId], references: [id], onDelete: Restrict)
  empleado           Empleado?           @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  ventas             Venta[]
  pedidos            PedidoProveedor[]
  movimientos        MovimientoInventario[]

  @@map("usuarios")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  icono       String?    @db.VarChar(50)
  color       String?    @db.VarChar(20)
  orden       Int?
  productos   Producto[]

  @@map("categorias")
}

model Proveedor {
  id                  Int               @id @default(autoincrement())
  nombre              String            @unique @db.VarChar(150)
  nit                 String?           @db.VarChar(30)
  email               String?           @db.VarChar(150)
  telefono            String            @db.VarChar(20)
  telefonoSecundario  String?           @map("telefono_secundario") @db.VarChar(20)
  contactoPrincipal   String?           @map("contacto_principal") @db.VarChar(100)
  direccion           String?           @db.Text
  condicionesPago     String?           @map("condiciones_pago") @db.VarChar(100)
  calificacion        Int?
  notas               String?           @db.Text
  estado              String            @default("Activo") @db.VarChar(20)
  creadoEn            DateTime          @default(now()) @map("creado_en")
  productos           Producto[]
  pedidos             PedidoProveedor[]

  @@map("proveedores")
}

model Producto {
  id             Int                    @id @default(autoincrement())
  oem            String                 @unique @db.VarChar(50)
  nombre         String                 @db.VarChar(150)
  marca          String?                @db.VarChar(100)
  categoriaId    Int                    @map("categoria_id")
  precio         Decimal                @db.Decimal(10, 2)
  precioCompra   Decimal?               @map("precio_compra") @db.Decimal(10, 2)
  stock          Int                    @default(0)
  stockMinimo    Int                    @default(5) @map("stock_minimo")
  ubicacion      String?                @db.VarChar(50)
  peso           Decimal?               @db.Decimal(8, 3)
  compatibilidad String                 @db.Text
  imagen         String?                @db.VarChar(500)
  notas          String?                @db.Text
  estado         String                 @default("Activo") @db.VarChar(20)
  proveedorId    Int?                   @map("proveedor_id")
  creadoEn       DateTime               @default(now()) @map("creado_en")
  
  categoria      Categoria              @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  proveedor      Proveedor?             @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  detallesVenta  DetalleVenta[]
  detallesPedido DetallePedidoProveedor[]
  movimientos    MovimientoInventario[]
  produccion     OrdenProduccion[]

  @@map("productos")
}

model Cliente {
  id                   Int      @id @default(autoincrement())
  nombre               String   @db.VarChar(150)
  nit                  String?  @db.VarChar(30)
  email                String?  @db.VarChar(150)
  telefono             String?  @db.VarChar(20)
  direccion            String?  @db.Text
  tipo                 String   @default("Particular") @db.VarChar(30)
  vehiculos            String?  @db.Text
  nivelFidelidad       String   @default("Nuevo") @map("nivel_fidelidad") @db.VarChar(20)
  descuentoPorcentaje  Decimal? @map("descuento_porcentaje") @db.Decimal(5, 2)
  limiteCredito        Decimal? @map("limite_credito") @db.Decimal(10, 2)
  notas                String?  @db.Text
  estado               String   @default("Activo") @db.VarChar(20)
  creadoEn             DateTime @default(now()) @map("creado_en")
  ventas               Venta[]

  @@map("clientes")
}

model Venta {
  id            Int            @id @default(autoincrement())
  clienteId     Int?           @map("cliente_id")
  usuarioId     Int?           @map("usuario_id")
  fecha         DateTime       @default(now())
  total         Decimal        @default(0.00) @db.Decimal(10, 2)
  descuento     Decimal?       @db.Decimal(10, 2)
  metodoPago    String         @default("Efectivo") @map("metodo_pago") @db.VarChar(30)
  nroFactura    String?        @map("nro_factura") @db.VarChar(30)
  observaciones String?        @db.Text
  estado        String         @default("Completada") @db.VarChar(20)
  
  cliente       Cliente?       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  detalles      DetalleVenta[]
  abonos        AbonoCredito[]

  @@map("ventas")
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  productoId     Int      @map("producto_id")
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@map("detalles_ventas")
}

model PedidoProveedor {
  id                    Int                      @id @default(autoincrement())
  proveedorId           Int                      @map("proveedor_id")
  usuarioId             Int                      @map("usuario_id")
  fecha                 DateTime                 @default(now())
  fechaEntregaEstimada  DateTime?                @map("fecha_entrega_estimada") @db.Date
  fechaRecepcion        DateTime?                @map("fecha_recepcion")
  nroReferencia         String?                  @map("nro_referencia") @db.VarChar(50)
  estado                String                   @default("Pendiente") @db.VarChar(20)
  total                 Decimal                  @default(0.00) @db.Decimal(10, 2)
  observaciones         String?                  @db.Text
  
  proveedor             Proveedor                @relation(fields: [proveedorId], references: [id], onDelete: Restrict)
  usuario               Usuario                  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  detalles              DetallePedidoProveedor[]

  @@map("pedidos_proveedor")
}

model DetallePedidoProveedor {
  id           Int             @id @default(autoincrement())
  pedidoId     Int             @map("pedido_id")
  productoId   Int             @map("producto_id")
  cantidad     Int
  precioCompra Decimal         @map("precio_compra") @db.Decimal(10, 2)
  
  pedido       PedidoProveedor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto     Producto        @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@map("detalles_pedidos_proveedor")
}

model MovimientoInventario {
  id             Int      @id @default(autoincrement())
  productoId     Int      @map("producto_id")
  tipoMovimiento String   @map("tipo_movimiento") @db.VarChar(20)
  cantidad       Int
  fecha          DateTime @default(now())
  motivo         String   @db.VarChar(255)
  usuarioId      Int?     @map("usuario_id")
  
  producto       Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuario        Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("movimientos_inventario")
}

model OrdenProduccion {
  id                Int       @id @default(autoincrement())
  productoId        Int       @map("producto_id")
  cantidad          Int
  cantidadProducida Int?      @map("cantidad_producida")
  prioridad         String    @default("Media") @db.VarChar(20)
  costoProduccion   Decimal?  @map("costo_produccion") @db.Decimal(10, 2)
  observaciones     String?   @db.Text
  fechaInicio       DateTime  @default(now()) @map("fecha_inicio")
  fechaFin          DateTime? @map("fecha_fin")
  estado            String    @default("Pendiente") @db.VarChar(30)
  responsableId     Int?      @map("responsable_id")
  
  producto          Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  responsable       Empleado? @relation(fields: [responsableId], references: [id], onDelete: SetNull)

  @@map("ordenes_produccion")
}

model AbonoCredito {
  id          Int      @id @default(autoincrement())
  ventaId     Int      @map("venta_id")
  monto       Decimal  @db.Decimal(10, 2)
  fecha       DateTime @default(now())
  metodoPago  String   @map("metodo_pago") @db.VarChar(30)
  comprobante String?  @map("comprobante") @db.VarChar(100)
  notas       String?  @db.Text
  
  venta       Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@map("abonos_credito")
}
